# lllm - Lou's Large Language Model
# Copy this file to .env and fill in your values

# Mistral API endpoint
LLLM_API_ENDPOINT=https://api.mistral.ai/v1/chat/completions

# Your Mistral API key
LLLM_API_KEY=your_mistral_api_key_here

# Model to use (optional, defaults to mistral-small-latest)
LLLM_MODEL=mistral-small-latest

# Max chained tool calls per user turn (default 10, 0 = unlimited)
LLLM_MAX_TOOL_CHAIN=10

# Sandbox backend for the shell tool: auto (default) | apple | docker | lima
#   apple: apple/container on macOS (lightweight vz microVM, ~1s start)
#   docker: any reachable Docker daemon (native on Linux, Desktop/OrbStack on macOS)
#   lima: Lima VM with Docker inside (macOS fallback)
LLLM_SANDBOX_BACKEND=auto

# Container image the shell tool runs in (default: alpine:latest)
LLLM_SANDBOX_IMAGE=alpine:latest

# Lima instance name for the lima backend (default: lllm-sandbox, auto-created)
LLLM_LIMA_INSTANCE=lllm-sandbox
